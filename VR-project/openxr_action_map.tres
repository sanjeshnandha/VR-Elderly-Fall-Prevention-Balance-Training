binding_path = "/user/hand/left/input/aim/pose"

[sub_resource type="OpenXRIPBinding" id="B_touch_aim_r"]
action = SubResource("Action_aim_pose")
binding_path = "/user/hand/right/input/aim/pose"

[sub_resource type="OpenXRIPBinding" id="B_touch_trig_l"]
action = SubResource("Action_trigger_click")
binding_path = "/user/hand/left/input/trigger/value"

[sub_resource type="OpenXRIPBinding" id="B_touch_trig_r"]
action = SubResource("Action_trigger_click")
binding_path = "/user/hand/right/input/trigger/value"

[sub_resource type="OpenXRIPBinding" id="B_touch_grip_l"]
action = SubResource("Action_grip_click")
binding_path = "/user/hand/left/input/squeeze/value"

[sub_resource type="OpenXRIPBinding" id="B_touch_grip_r"]
action = SubResource("Action_grip_click")
binding_path = "/user/hand/right/input/squeeze/value"

[sub_resource type="OpenXRInteractionProfile" id="IP_touch"]
interaction_profile_path = "/interaction_profiles/oculus/touch_controller"
bindings = [SubResource("B_touch_pose_l"), SubResource("B_touch_pose_r"), SubResource("B_touch_aim_l"), SubResource("B_touch_aim_r"), SubResource("B_touch_trig_l"), SubResource("B_touch_trig_r"), SubResource("B_touch_grip_l"), SubResource("B_touch_grip_r")]

; --- HTC Vive wand ----------------------------------------------------------

[sub_resource type="OpenXRIPBinding" id="B_vive_pose_l"]
action = SubResource("Action_default_pose")
binding_path = "/user/hand/left/input/grip/pose"

[sub_resource type="OpenXRIPBinding" id="B_vive_pose_r"]
action = SubResource("Action_default_pose")
binding_path = "/user/hand/right/input/grip/pose"

[sub_resource type="OpenXRIPBinding" id="B_vive_aim_l"]
action = SubResource("Action_aim_pose")
binding_path = "/user/hand/left/input/aim/pose"

[sub_resource type="OpenXRIPBinding" id="B_vive_aim_r"]
action = SubResource("Action_aim_pose")
binding_path = "/user/hand/right/input/aim/pose"

[sub_resource type="OpenXRIPBinding" id="B_vive_trig_l"]
action = SubResource("Action_trigger_click")
binding_path = "/user/hand/left/input/trigger/click"

[sub_resource type="OpenXRIPBinding" id="B_vive_trig_r"]
