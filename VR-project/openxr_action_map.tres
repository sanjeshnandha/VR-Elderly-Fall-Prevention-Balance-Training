binding_path = "/user/hand/right/input/trigger/click"

[sub_resource type="OpenXRIPBinding" id="B_vive_grip_l"]
action = SubResource("Action_grip_click")
binding_path = "/user/hand/left/input/squeeze/click"

[sub_resource type="OpenXRIPBinding" id="B_vive_grip_r"]
action = SubResource("Action_grip_click")
binding_path = "/user/hand/right/input/squeeze/click"

[sub_resource type="OpenXRInteractionProfile" id="IP_vive"]
interaction_profile_path = "/interaction_profiles/htc/vive_controller"
bindings = [SubResource("B_vive_pose_l"), SubResource("B_vive_pose_r"), SubResource("B_vive_aim_l"), SubResource("B_vive_aim_r"), SubResource("B_vive_trig_l"), SubResource("B_vive_trig_r"), SubResource("B_vive_grip_l"), SubResource("B_vive_grip_r")]

[resource]
action_sets = [SubResource("ActionSet_main")]
interaction_profiles = [SubResource("IP_simple"), SubResource("IP_index"), SubResource("IP_touch"), SubResource("IP_vive")]
