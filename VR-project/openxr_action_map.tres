[sub_resource type="OpenXRIPBinding" id="B_touch_pose_r"]
action = SubResource("Action_default_pose")
binding_path = "/user/hand/right/input/grip/pose"

[sub_resource type="OpenXRIPBinding" id="B_touch_aim_l"]
