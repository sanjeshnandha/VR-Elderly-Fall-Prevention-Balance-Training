going = 0.25
width = 0.9
uneven_step_index = 5
uneven_extra_rise = 0.025
landing_depth = 0.8

; --- The good rail (west side) ---------------------------------------------
; Inclined at atan(0.19 / 0.25) = 37.2 degrees, 0.9 m above the nosing line,
; which is the standard domestic handrail height. The basis below points the
; rail's local +X axis straight up the slope.

[node name="StairRailWest" type="Area3D" parent="."]
transform = Transform3D(0, 0.6051, 0.7962, 0, 0.7962, -0.6051, -1, 0, 0, -1.1, 1.78, 0.6)
script = ExtResource("5_rail")
rail_id = "stair_rail_west"
span = 1.15
radius = 0.021
rail_color = Color(0.72, 0.53, 0.33, 1)

; --- The broken rail (east side) -------------------------------------------
; Two brackets and nothing between them. This is the hazard to spot; the west
; rail is what you are expected to use instead.

