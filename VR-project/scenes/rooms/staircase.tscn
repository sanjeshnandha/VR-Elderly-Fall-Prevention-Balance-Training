; ============================================================================
;  STAIRCASE  --  2.6 x 5.2 m stairwell, 4.0 m to the upper floor, no ceiling.
;
;  Eight treads at a real domestic 190 mm rise / 250 mm going, then a landing.
;  Tread 5 is 25 mm taller than the rest: an unexpectedly tall step is one of
;  the most common domestic trip causes precisely because it is near-invisible.
;
;  This room is where Architectural Fix 5.1 lives. Read it top to bottom:
;
;    GatedRegion            free-aim teleport is switched off in this room, and
;                           no destination inside it is legal from outside it
;    TP_Bottom              always active -- the way in
;    TP_Step3 / TP_Step6    active ONLY while StairRailWest is held
;    TP_Landing             active ONLY while held AND TP_Step6 has been used
;
;  So the flight must be taken landing by landing, with a hand on the rail, and
;  there is no aim that skips it. The habit is enforced by the locomotion
;  system, not merely recorded by StairTransitZone afterwards.
; ============================================================================

[node name="Staircase" type="Node3D"]

[node name="RoomBuilder" type="Node3D" parent="."]
script = ExtResource("1_room")
size = Vector2(2.6, 5.2)
height = 4.0
floor_color = Color(0.45, 0.4, 0.36, 1)
wall_color = Color(0.78, 0.75, 0.7, 1)
build_ceiling = false
openings = Array[Vector4]([Vector4(1, 0, 0.9, 2.03)])

; Deliberately underpowered and warm-tinted. Stairwell lighting that is merely
; "a bit dim" is a real and very common hazard; a dark stairwell would be an
; obvious one, which is a different and much easier task.

[node name="StairLight" type="OmniLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 3.4, 0.4)
light_color = Color(1, 0.87, 0.68, 1)
light_energy = 0.35
omni_range = 7.0

[node name="LightFixture" type="Node3D" parent="."]
