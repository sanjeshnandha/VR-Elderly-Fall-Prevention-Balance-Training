box_size = Vector3(0.26, 0.12, 0.26)
color = Color(0.95, 0.9, 0.75, 1)
emissive = true
collide = false

[node name="Flight" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -0.4)
