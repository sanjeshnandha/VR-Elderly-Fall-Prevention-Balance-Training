[gd_scene load_steps=15 format=3 uid="uid://cvrfp0mainscene1"]

[ext_resource type="PackedScene" path="res://scenes/player/xr_player.tscn" id="1_player"]
[ext_resource type="PackedScene" path="res://scenes/rooms/hallway.tscn" id="2_hall"]
[ext_resource type="PackedScene" path="res://scenes/rooms/bathroom.tscn" id="3_bath"]
[ext_resource type="PackedScene" path="res://scenes/rooms/bedroom.tscn" id="4_bed"]
[ext_resource type="PackedScene" path="res://scenes/rooms/staircase.tscn" id="5_stair"]
[ext_resource type="Script" path="res://scripts/ui/viewport_panel_3d.gd" id="6_panel"]
[ext_resource type="PackedScene" path="res://scenes/ui/instruction_panel.tscn" id="7_instr"]
[ext_resource type="PackedScene" path="res://scenes/ui/debrief_panel.tscn" id="8_debrief"]
[ext_resource type="Script" path="res://scripts/ui/wall_button.gd" id="9_button"]
[ext_resource type="Script" path="res://scripts/balance/balance_exercise.gd" id="10_balance"]
[ext_resource type="Script" path="res://scripts/balance/balance_orb.gd" id="11_orb"]
[ext_resource type="Script" path="res://scripts/session_director.gd" id="12_director"]
[ext_resource type="Script" path="res://scripts/util/xr_tools_bridge.gd" id="13_bridge"]

[sub_resource type="Environment" id="Env_house"]
background_mode = 1
background_color = Color(0.06, 0.06, 0.08, 1)
ambient_light_source = 2
ambient_light_color = Color(0.62, 0.64, 0.7, 1)
ambient_light_energy = 0.55
tonemap_mode = 2
ssao_enabled = false
glow_enabled = false

; ============================================================================
;  MAIN SCENE  --  the whole session.
;
;  HOUSE PLAN, viewed from above (1 unit = 1 metre, always):
;
;        -Z (north)
;      +----------------+        +--------------------+
;      |   BATHROOM     |        |      BEDROOM       |
;      |   3.0 x 3.0    |        |     4.0 x 3.6      |
;      +------+  +------+        +--------+  +--------+
;             |  |                        |  |            doorways 0.9 x 2.03
;   +---------+  +------------------------+  +----------------+
;   |                     HALLWAY  8.0 x 2.6                   |
;   |  ^ start here, facing the instruction panel               |
;   +--------------------------+  +----------------------------+
;                              |  |
;                     +--------+  +--------+
;                     |     STAIRCASE      |
;                     |     2.6 x 5.2      |
;                     +--------------------+
;        +Z (south)
;
;  Start position is the west end of the hallway, facing the wall-mounted
;  instruction panel and the three physical buttons beneath it. There is no
;  controller menu anywhere in the application (Architectural Fix 5.4).
;
;  If you install godot-xr-tools, the XRToolsBridge node under XRPlayer picks it
;  up automatically -- see scripts/util/xr_tools_bridge.gd. It is inert without
;  the addon, so it is safe to leave in place either way.
; ============================================================================

[node name="Main" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env_house")

[node name="SunThroughWindows" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.86, -0.35, 0.37, 0, 0.73, 0.68, -0.51, -0.59, 0.63, 0, 4, 0)
light_energy = 0.35
shadow_enabled = true

; --- The house -------------------------------------------------------------

[node name="House" type="Node3D" parent="."]

[node name="Hallway" parent="House" instance=ExtResource("2_hall")]

[node name="Bathroom" parent="House" instance=ExtResource("3_bath")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -2.5, 0, -2.8)

[node name="Bedroom" parent="House" instance=ExtResource("4_bed")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 2.5, 0, -3.1)

[node name="Staircase" parent="House" instance=ExtResource("5_stair")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 3.9)

; --- Player ----------------------------------------------------------------
; Facing -X, i.e. straight at the instruction panel on the west wall.

[node name="XRPlayer" parent="." instance=ExtResource("1_player")]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, -2, 0, 0)

[node name="XRToolsBridge" type="Node" parent="XRPlayer"]
script = ExtResource("13_bridge")
auto_wire = true

; --- Start area: panel at 1.85 m, three large physical buttons below it -----

[node name="InstructionPanel" type="Node3D" parent="."]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, -3.85, 1.45, 0)
script = ExtResource("6_panel")
view_distance = 1.75
panel_size = Vector2(1.2, 0.9)
viewport_size = Vector2i(1600, 1200)
content_scene = ExtResource("7_instr")
follow_player = false

[node name="ButtonStart" type="Area3D" parent="."]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, -3.88, 0.95, -0.62)
script = ExtResource("9_button")
label_text = "START"
sub_label_text = "Begin the session"
button_size = Vector2(0.28, 0.18)
base_color = Color(0.18, 0.49, 0.2, 1)

[node name="ButtonSeated" type="Area3D" parent="."]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, -3.88, 0.95, 0)
script = ExtResource("9_button")
label_text = "Seated mode"
sub_label_text = "Currently: OFF"
button_size = Vector2(0.28, 0.18)
base_color = Color(0.16, 0.35, 0.55, 1)

[node name="ButtonRepeat" type="Area3D" parent="."]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, -3.88, 0.95, 0.62)
script = ExtResource("9_button")
label_text = "Say that again"
sub_label_text = "Repeat the instructions"
button_size = Vector2(0.28, 0.18)
base_color = Color(0.45, 0.35, 0.12, 1)

; --- East end of the hallway: balance exercise and finish -------------------

[node name="ButtonBalance" type="Area3D" parent="."]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, 3.9, 0.95, -0.4)
script = ExtResource("9_button")
label_text = "Balance exercise"
sub_label_text = "Start the reaching task"
button_size = Vector2(0.3, 0.18)
base_color = Color(0.35, 0.24, 0.5, 1)

[node name="ButtonFinish" type="Area3D" parent="."]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, 3.9, 0.95, 0.4)
script = ExtResource("9_button")
label_text = "FINISH"
sub_label_text = "End the session"
button_size = Vector2(0.3, 0.18)
base_color = Color(0.18, 0.49, 0.2, 1)
enabled = false

; --- Balance exercise ------------------------------------------------------
; The orb's position here is irrelevant: BalanceExercise places it relative to
; the baseline head position captured at "Go!" (Architectural Fix 5.5).

[node name="BalanceExercise" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 2.5, 0, -3.1)
script = ExtResource("10_balance")
trial_yaw_offsets = Array[float]([0.0, 45.0, -45.0])
reach_distance = 0.55
orb_height_offset = -0.15
countdown_seconds = 3.0
sway_tolerance = 0.2
orb_path = NodePath("BalanceOrb")

[node name="BalanceOrb" type="Area3D" parent="BalanceExercise"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.3, 0)
script = ExtResource("11_orb")
radius = 0.09

; --- Debrief panel ---------------------------------------------------------
; Hidden until the session ends, then placed in front of wherever the
; participant is standing, at the lens focal distance.

[node name="DebriefPanel" type="Node3D" parent="."]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, -3.8, 1.45, 0)
visible = false
script = ExtResource("6_panel")
view_distance = 1.75
panel_size = Vector2(1.4, 1.05)
viewport_size = Vector2i(1600, 1200)
content_scene = ExtResource("8_debrief")
follow_player = false

; --- Director --------------------------------------------------------------

[node name="SessionDirector" type="Node" parent="."]
script = ExtResource("12_director")
instruction_panel_path = NodePath("../InstructionPanel")
debrief_panel_path = NodePath("../DebriefPanel")
balance_exercise_path = NodePath("../BalanceExercise")
begin_button_path = NodePath("../ButtonStart")
seated_button_path = NodePath("../ButtonSeated")
repeat_button_path = NodePath("../ButtonRepeat")
balance_button_path = NodePath("../ButtonBalance")
finish_button_path = NodePath("../ButtonFinish")
auto_start_balance = true
