[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="hazard"
3d_physics/layer_4="grabbable"
3d_physics/layer_5="teleport_target"
3d_physics/layer_6="ui"
3d_physics/layer_7="hand"

[physics]

common/physics_ticks_per_second=90

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
anti_aliasing/quality/msaa_3d=2

[xr]

; ---------------------------------------------------------------------------
; OpenXR is OFF for desktop development and ON for the VR build.
;
; Godot has no working OpenXR runtime on macOS, and leaving this enabled there
; makes the engine try to bring up a runtime that does not exist before the main
; scene ever loads -- the game appears to start and then does nothing.
;
; TO BUILD FOR A HEADSET (Windows or Linux, SteamVR running):
;   1. set openxr/enabled=true below, or tick
;      Project > Project Settings > XR > OpenXR > Enabled
;   2. open Project Settings > OpenXR > Action Map, confirm the four actions
;      (default, aim, trigger_click, grip_click) are present, and press Save.
;      That regenerates openxr_action_map.tres in your exact Godot version's
;      format, which is more reliable than the checked-in file across versions.
;
; With this off, XRPlayer detects no runtime and enables the desktop rig
; (WASD + mouse) automatically. Nothing else in the project changes.
; ---------------------------------------------------------------------------
openxr/enabled=false
openxr/default_action_map="res://openxr_action_map.tres"
openxr/form_factor=0
openxr/view_configuration=1
openxr/reference_space=1
openxr/environment_blend_mode=0
shaders/enabled=true
