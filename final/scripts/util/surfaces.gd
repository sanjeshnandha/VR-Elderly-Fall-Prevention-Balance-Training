@tool
class_name Surfaces
extends RefCounted
## The material library: one StandardMaterial3D per named surface, built in code
## from the PBR maps in assets/textures/.
##
## WHY IN CODE and not as .tres files. The maps are generated by
## tools/make_textures.py rather than committed, and a .tres that points at a
## texture which has not been imported yet is a hard load error -- the room
## fails to open at all. Built in code, a missing map is just a missing map: the
## material falls back to a flat colour, the house still runs, and it upgrades
## itself silently the moment the editor has imported the PNGs. That property is
## worth more here than an editable resource file.
##
## UV MAPPING: WORLD-SPACE TRIPLANAR, for everything architectural.
## The house is built from dozens of separate boxes -- a wall is up to five
## segments, each room has its own floor slab -- and with ordinary box UVs every
## one of them restarts the pattern at its own corner, so the floorboards would
## jump at each doorway and the tiles would step at the bathroom threshold.
## World triplanar takes the texture coordinate from the WORLD POSITION instead,
## so the boards run the whole length of the hallway and the grout lines carry
## across a join, with no UV authoring at all. It also means a prop needs no
## correct UVs of its own, which is what makes MeshKit's filleted boxes usable
## straight away.
##
## Anything that MOVES must pass world_uv = false, or its texture stands still
## in the world while the object slides through it. The street car and the
## balance orb are the two that matter.
##
## `metres` is how much of the world one tile of the texture covers. It is the
## one number to change if a pattern reads too large or too small, and it starts
## from what tools/make_textures.py recorded in assets/textures/manifest.json.

const DIR := "res://assets/textures/"

## Per surface:
##   metres     world size of one tile of the texture
##   fallback   flat colour used until the maps are imported (alpha < 1 makes
##              the material transparent)
##   rough      roughness when there is no roughness map
##   metallic   0 for everything dielectric, 1 for bare metal
##   specular   dielectric reflectance, 0.5 unless the surface is glassy
##   normal     normal-map strength
##   sharpness  triplanar blend sharpness; higher is crisper on curved faces
##   clearcoat  true for a lacquered or glazed top coat
##
## Surfaces with no PNGs (glass, chrome, ceramic ...) are deliberately plain:
## a texture would only add noise to something that reads by its reflection.
const SPECS := {
	# --- floors -----------------------------------------------------------
	"oak_floor":       {"metres": 2.0, "fallback": Color("#a97a4c"), "normal": 1.0, "clearcoat": true},
	"tile_floor":      {"metres": 1.2, "fallback": Color("#dcd8d1"), "normal": 0.8, "clearcoat": true},
	"slate_floor":     {"metres": 1.6, "fallback": Color("#53575b"), "normal": 1.1},
	"carpet":          {"metres": 1.0, "fallback": Color("#b6a893"), "normal": 1.3},
	"wool_rug":        {"metres": 2.4, "fallback": Color("#8d4f43"), "normal": 1.0},

	# --- walls and ceilings ----------------------------------------------
	"plaster_wall":    {"metres": 2.5, "fallback": Color("#e4ded2"), "normal": 0.5},
	"ceiling_plaster": {"metres": 2.5, "fallback": Color("#f2f0ea"), "normal": 0.35},
	"wallpaper":       {"metres": 1.6, "fallback": Color("#c8cfbe"), "normal": 0.6},
	"subway_tile":     {"metres": 0.8, "fallback": Color("#f1efe9"), "normal": 0.9, "clearcoat": true},
	"brick":           {"metres": 1.6, "fallback": Color("#8d5040"), "normal": 1.2},
	"exterior_render": {"metres": 2.5, "fallback": Color("#d9d2c4"), "normal": 0.8},
	"roof_tile":       {"metres": 1.4, "fallback": Color("#5e504a"), "normal": 1.2},

	# --- outside ----------------------------------------------------------
	"paving":          {"metres": 1.8, "fallback": Color("#b0ada5"), "normal": 1.0},
	"asphalt":         {"metres": 2.0, "fallback": Color("#3b3b3d"), "normal": 1.0},
	"grass":           {"metres": 1.5, "fallback": Color("#5b7a3c"), "normal": 1.1},

	# --- furniture --------------------------------------------------------
	"oak_wood":        {"metres": 1.0, "fallback": Color("#ae8353"), "normal": 0.7, "clearcoat": true},
	"walnut_wood":     {"metres": 1.0, "fallback": Color("#543725"), "normal": 0.7, "clearcoat": true},
	"paint_satin":     {"metres": 1.0, "fallback": Color("#f3f1ec"), "normal": 0.4},
	"upholstery":      {"metres": 0.5, "fallback": Color("#6a7480"), "normal": 1.2},
	"linen":           {"metres": 0.6, "fallback": Color("#e8e2d6"), "normal": 1.0},
	"leather":         {"metres": 0.6, "fallback": Color("#7a4f39"), "normal": 1.0},
	"quartz":          {"metres": 1.2, "fallback": Color("#ddd9d1"), "normal": 0.4, "clearcoat": true},
	"brushed_metal":   {"metres": 0.5, "fallback": Color("#b9bcc0"), "normal": 0.5,
		"metallic": 0.9, "rough": 0.3},
	# Drain ironwork. Not "steel_dark", which it used to share with the taps: a
	# bright 85 %-metallic surface turns a gully grating into a mirror lying on
	# the path, which is most of why the first one read as a dark floor tile.
	"cast_iron":       {"metres": 0.45, "fallback": Color("#55524e"), "normal": 1.2,
		"metallic": 0.55, "rough": 0.52},

	# Water is in the library for its `metres` and its maps; the actual puddle
	# material is built by puddle.gd, which needs vertex alpha and a rim term
	# that no shared material should carry.
	"water":           {"metres": 0.55, "fallback": Color(0.88, 0.93, 0.95, 0.45),
		"rough": 0.04, "normal": 0.55, "specular": 0.55},

	# --- untextured, read by their reflection ------------------------------
	"glass":           {"fallback": Color(0.80, 0.88, 0.92, 0.16), "rough": 0.02, "specular": 1.0},
	"glass_frosted":   {"fallback": Color(0.88, 0.92, 0.94, 0.55), "rough": 0.35, "specular": 0.8},
	"mirror":          {"fallback": Color("#e9edf0"), "rough": 0.02, "metallic": 1.0},
	"chrome":          {"fallback": Color("#cfd4d8"), "rough": 0.1, "metallic": 1.0},
	"steel_dark":      {"fallback": Color("#4a4e52"), "rough": 0.34, "metallic": 0.85},
	"ceramic":         {"fallback": Color("#f5f3ee"), "rough": 0.07, "clearcoat": true},
	"screen":          {"fallback": Color("#0d0e10"), "rough": 0.14},
	"lampshade":       {"fallback": Color("#f7efdc"), "rough": 0.72},
	"rubber":          {"fallback": Color("#24262a"), "rough": 0.88},
	"paper":           {"fallback": Color("#efece4"), "rough": 0.9},
	"foliage":         {"fallback": Color("#43703a"), "rough": 0.68},
	"terracotta":      {"fallback": Color("#a5613f"), "rough": 0.62},
	"paint_red":       {"fallback": Color("#a33a2e"), "rough": 0.45},
	"paint_dark":      {"fallback": Color("#2f3338"), "rough": 0.5},
}

## Materials are shared: two hundred props asking for "oak_wood" get one
## material, one shader compile and one texture upload.
static var _cache: Dictionary = {}


## True if `surface` is a name this library knows.
static func known(surface: String) -> bool:
	return SPECS.has(surface)


## The shared material for `surface`, or null if the name is unknown or empty --
## callers fall back to a plain colour, which is what keeps a typo from taking
## the whole room down.
static func get_material(surface: String, world_uv: bool = true) -> StandardMaterial3D:
	if surface.is_empty():
		return null
	var key := surface if world_uv else surface + "@local"
	if _cache.has(key):
		return _cache[key] as StandardMaterial3D
	var mat := _build(surface, world_uv)
	_cache[key] = mat
	return mat


## Drop the cache. Call after re-running tools/make_textures.py so the editor
## picks the new maps up without a restart.
static func clear_cache() -> void:
	_cache.clear()


## How many metres of world one tile of `surface` covers. Used by the few places
## that need to line a pattern up with real geometry.
static func metres(surface: String) -> float:
	var spec: Dictionary = SPECS.get(surface, {})
	return maxf(float(spec.get("metres", 1.0)), 0.01)


static func _build(surface: String, world_uv: bool) -> StandardMaterial3D:
	if not SPECS.has(surface):
		push_warning("Surfaces: no surface named '%s'. Falling back to a plain colour." % surface)
		return null
	var spec: Dictionary = SPECS[surface]

	var mat := StandardMaterial3D.new()
	mat.resource_name = surface

	var fallback: Color = spec.get("fallback", Color(0.72, 0.70, 0.66))
	mat.albedo_color = fallback

	var albedo := _tex(surface, "albedo")
	if albedo != null:
		mat.albedo_texture = albedo
		# The map already carries the colour; keeping the fallback here would
		# tint it a second time. The alpha is kept, so glass stays glass.
		mat.albedo_color = Color(1.0, 1.0, 1.0, fallback.a)

	var nrm := _tex(surface, "normal")
	if nrm != null:
		mat.normal_enabled = true
		mat.normal_texture = nrm
		mat.normal_scale = float(spec.get("normal", 1.0))

	var rough := _tex(surface, "rough")
	if rough != null:
		# The map holds absolute roughness, so the scalar has to be 1.0.
		mat.roughness = 1.0
		mat.roughness_texture = rough
		mat.roughness_texture_channel = BaseMaterial3D.TEXTURE_CHANNEL_GRAYSCALE
	else:
		mat.roughness = float(spec.get("rough", 0.8))

	mat.metallic = float(spec.get("metallic", 0.0))
	mat.metallic_specular = float(spec.get("specular", 0.5))

	if fallback.a < 1.0:
		mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
		# Glass you can see the far side of, rather than a single lit sheet.
		mat.cull_mode = BaseMaterial3D.CULL_DISABLED

	if bool(spec.get("clearcoat", false)):
		mat.clearcoat_enabled = true
		mat.clearcoat = 0.55
		mat.clearcoat_roughness = 0.08

	# World triplanar: see the note at the top of this file.
	mat.uv1_triplanar = true
	mat.uv1_world_triplanar = world_uv
	var m := metres(surface)
	mat.uv1_scale = Vector3.ONE / m
	mat.uv1_triplanar_sharpness = float(spec.get("sharpness", 1.0))
	mat.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC

	return mat


static func _tex(surface: String, kind: String) -> Texture2D:
	var path := "%s%s_%s.png" % [DIR, surface, kind]
	if not ResourceLoader.exists(path):
		return null
	return load(path) as Texture2D
