[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="hazard"
3d_physics/layer_4="grabbable"
3d_physics/layer_5="teleport_target"
3d_physics/layer_6="ui"
3d_physics/layer_7="hand"

[physics]

common/physics_ticks_per_second=90

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1

[xr]

openxr/form_factor=0
openxr/view_configuration=1
openxr/reference_space=1
openxr/environment_blend_mode=0
shaders/enabled=true
