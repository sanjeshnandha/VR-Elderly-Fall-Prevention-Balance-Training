; ============================================================================
;  LIVING ROOM  --  3.8 x 4.7 m, 2.4 m ceiling. Doorway on the +Z wall.
;
;  The room where people spend the most time, and where two of the most common
;  domestic falls happen: catching a foot on something low and dark on the
;  floor, and failing to get out of a seat.
;
;  Hazards
;    the sofa        0.40 m seat, deep, no arms -- nothing to push up on, so
;                    standing has to be done with the legs alone. The single
;                    most common "I fell getting up" in this age group.
;    coffee table    glass, 0.38 m tall, right on the route from the door. Low
;                    and see-through is the worst combination: the eye does not
;                    register it and the shin does.
;    trailing flex   the TV lead run across the floor rather than round the
;                    skirting.
;    footstool       left where it was last used, just inside the door.
;
;  The armchair is the DECOY: firm, 0.48 m seat, proper arms. It is there as
;  the good example -- flagging it costs nothing, and noticing the difference
;  between the two seats is the whole lesson of this room.
;
;  ------------------------------------------------------------------------
;  ON THE DRESSING OF THIS ROOM. Every hazard node below -- its id, position,
;  trigger size and wording -- is exactly what it was before the realism pass.
;  What changed is only what you can see: real materials instead of flat
;  colours, a window cut into the wall instead of a bright panel stuck on it,
;  and the ordinary clutter of a lived-in room (cushions, a throw, books on the
;  table, curtains, a radiator, a plant, a light switch). The clutter matters
;  for the training, not just the look: a hazard is only a real test of
;  discrimination if it sits among things that are NOT hazards. A trailing flex
;  is easy to spot in an empty room.
;
;  Everything added for looks has collide = false unless it is furniture you
;  would actually bump into, so none of it changes where you can walk, what the
;  teleport arc stops at, or what the hand can reach.
; ============================================================================

[node name="LivingRoom" type="Node3D"]

[node name="RoomBuilder" type="Node3D" parent="."]
script = ExtResource("1_room")
size = Vector2(3.8, 4.7)
height = 2.4
floor_surface = "oak_floor"
wall_surface = "wallpaper"
ceiling_surface = "ceiling_plaster"
trim_surface = "paint_satin"
floor_color = Color(0.52, 0.44, 0.36, 1)
wall_color = Color(0.86, 0.84, 0.79, 1)
; Wall 0 (+Z) is the hallway's wall, doorway and all.
build_walls = Array[bool]([false, true, true, true])
openings = Array[Vector4]([])
; A real window in the -Z wall: 1.5 x 1.2 m on an 850 mm sill, which is where
; the old flat "Window" panel used to be painted on. RoomBuilder gives it a
; lining, a projecting sill, glazing bars and a pane that stops the arc.
window_openings = Array[Vector4]([Vector4(1, 0, 1.5, 1.2)])
window_sill_height = 0.85

[node name="RoomZone" type="Area3D" parent="."]
