[node name="HazardUnevenStep" type="Area3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.62, -0.275)
script = ExtResource("4_hazard")
hazard_id = "stairs_uneven_step"
hazard_name = "Uneven step"
room = "staircase"
is_hazard = true
explanation = "This tread is taller than the others. Look at each step on the way up and down."
; Floor to tread top, not a band around the nosing. staircase.gd models each
; tread as a solid block from the floor up, so a volume that covered only the
; top 150 mm of step 5 contained an eighth of that block -- far less than the
; fraction hazard.gd needs before it lights a mesh up, which is why the uneven
; step never glowed. 1.24 m tall catches step 5 whole and still misses its
; neighbours, which are 250 mm away along the flight.
extents = Vector3(0.9, 1.24, 0.28)
label_height = 0.55

