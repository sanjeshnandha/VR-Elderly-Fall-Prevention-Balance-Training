; ============================================================================
;  BATHROOM  --  3.0 x 3.0 m, 2.4 m ceiling. Doorway on the +Z wall.
;
;  Hazards: wet tile floor (with a slip trigger), and no grab bar within reach
;  of the point where you actually step into the bath.
;
;  The short bar that IS fitted sits at the far end of the tub -- a very common
;  real-world installation error. There is something to hold; it is just not
;  where you need it, which is exactly the "no grab bar" hazard. Because of
;  that, rail COMPLIANCE is not scored in this room (see the note further
;  down): it is measured on the stairs, where the rail is where it belongs.
; ============================================================================

[node name="Bathroom" type="Node3D"]

[node name="RoomBuilder" type="Node3D" parent="."]
script = ExtResource("1_room")
glazing_surface = "glass_frosted"
window_sill_height = 1.55
window_openings = Array[Vector4]([Vector4(1, -0.3, 0.7, 0.55)])
skirting = false
trim_surface = "paint_satin"
ceiling_surface = "ceiling_plaster"
wall_surface = "subway_tile"
floor_surface = "tile_floor"
size = Vector2(3, 3)
height = 2.4
floor_color = Color(0.79, 0.82, 0.83, 1)
wall_color = Color(0.87, 0.9, 0.9, 1)
; Wall 0 (+Z) is the hallway's wall, doorway and all: building it here as well
; would put two identical boxes in the same plane and make them flicker.
build_walls = Array[bool]([false, true, true, true])
openings = Array[Vector4]([])

