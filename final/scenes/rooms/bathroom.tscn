; --- Core System I: the walking route -------------------------------------
; Finding a hazard and getting past one are different skills. These rings are
; the second: cross the room, one ring at a time, without touching anything.
; Some legs are deliberately NOT walkable in a straight line -- the direct path
; goes through something -- so the task is to see that and go round. Every leg
; was checked to have a clear path before it was placed here.

[node name="Route" type="Node3D" parent="."]
script = ExtResource("90_route")
room = "bathroom"
start_line = "Now cross the bathroom to the basin, keeping off anything slippery."

[node name="Marker1" type="Area3D" parent="Route"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.35, 0.0, 1.15)
script = ExtResource("91_marker")
marker_id = "bathroom_1"
room = "bathroom"
label_text = "in the doorway"
extents = Vector3(0.9, 3, 0.9)

[node name="Marker2" type="Area3D" parent="Route"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.05, 0.0, 0.9)
script = ExtResource("91_marker")
marker_id = "bathroom_2"
room = "bathroom"
label_text = "by the bath"
extents = Vector3(0.9, 3, 0.9)

[node name="Marker3" type="Area3D" parent="Route"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.55, 0.0, -0.45)
script = ExtResource("91_marker")
marker_id = "bathroom_3"
room = "bathroom"
label_text = "at the basin"
extents = Vector3(0.9, 3, 0.9)

; --- Core System I: more hazard footprints ---------------------------------
; Added with the walking route. These are the floor-level obstacles that had no
; zone of their own, so walking into them was previously unrecorded. They warn
; as the older zones do, and they give the route something to go round.

[node name="SlipZoneBathMat" type="Area3D" parent="."]
