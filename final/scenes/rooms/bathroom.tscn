; --- The wet patch ---------------------------------------------------------
; Low roughness + slight metallic reads as a sheen of standing water without
; needing a custom shader or a normal map.

[node name="WetFloor" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.4, 0, 0.05)
script = ExtResource("30_puddle")
; Was a 10 mm rounded box, pale blue, 35% metallic, 75% opaque -- which is
; four wrong answers about water at once. See puddle.gd.
size = Vector2(1.7, 1.3)
shape_seed = 1
; No damp ring. It was tried at 0.26 and again at 0.10 and both read as a
; tidemark rather than as wet floor -- see puddle.gd. Set damp_margin above
; zero to bring it back.
damp_margin = 0.0

[node name="HazardWetFloor" type="Area3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.4, 0.25, 0.42)
script = ExtResource("3_hazard")
hazard_id = "bathroom_wet_floor"
hazard_name = "Wet tile floor"
room = "bathroom"
is_hazard = true
explanation = "Wet tile is one of the most slippery surfaces in the house. Dry it or wait before stepping on it."
; The band of wet tile beyond the bath mat; see HazardBathMat.
extents = Vector3(1.7, 0.5, 0.56)
label_height = 0.7
; Named rather than inferred. The volume covers only the band of the patch that
; is NOT under the bath mat, so 43% of the water sits inside it -- just under
; the fraction hazard.gd needs before it lights a mesh up, which would have left
; the wet floor the one hazard in the house with no glow. The puddle builds its
; surface at run time as a child called "Water"; see puddle.gd `_rebuild()`.
highlight_meshes = Array[NodePath]([NodePath("../WetFloor/Water")])

[node name="SlipZoneWetFloor" type="Area3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.4, 1, 0.05)
script = ExtResource("6_slip")
; Measured against the puddle mesh: this is the largest rectangle of which
; 95% is actually under water. The visible spill is irregular, so a
; footprint drawn to its bounding box would penalise dry corners.
route_extents = Vector3(1.33, 0.3, 1.01)
zone_id = "bathroom_wet_floor_slip"
room = "bathroom"
linked_hazard_path = NodePath("../HazardWetFloor")
warning_line = "Careful. This floor is wet and slippery."
; Warning volume: 0.25 m of approach before the spoken line. Nothing is
; scored against it -- see route_extents.
extents = Vector3(2.2, 2.0, 2.2)

[node name="HazardNoGrabBar" type="Area3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.05, 1.06, -0.6)
script = ExtResource("3_hazard")
hazard_id = "bathroom_no_grab_bar"
hazard_name = "No grab bar where you step in"
room = "bathroom"
is_hazard = true
explanation = "There is nothing to hold at the end of the bath you actually step into. A grab bar here gives you something solid."
; Raised to where a grab bar would actually be fitted -- above the tub rim,
; on the wall -- so it is not a third volume competing for the same patch of
; floor as the mat and the wet tile.
extents = Vector3(0.8, 0.88, 0.7)
label_height = 0.75

; --- Hazard: the bath mat that slides ---------------------------------------

[node name="BathMat" type="Node3D" parent="."]
