[node name="HazardBathMat" type="Area3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.55, 0.16, -0.25)
script = ExtResource("3_hazard")
hazard_id = "bathroom_bath_mat"
hazard_name = "Bath mat with no grip underneath"
room = "bathroom"
is_hazard = true
explanation = "A mat that slides on wet tile is worse than no mat at all. Use one with a rubber backing, or fix it down."
; Low and tight to the mat. The mat lies ON the wet floor, so the two can
; only be told apart by where you point: this one owns the mat, and the wet
; floor owns the tile the mat does not cover.
extents = Vector3(1.0, 0.32, 0.72)
label_height = 0.55

; A safe object. Flagging it is logged as a false positive, not punished --
; over-caution is a habit worth encouraging in this population.

[node name="DecoyTowelRail" type="Area3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.4, 1.25, 0.9)
script = ExtResource("3_hazard")
hazard_id = "bathroom_towel_rail"
hazard_name = "Towel rail"
room = "bathroom"
is_hazard = false
extents = Vector3(0.25, 0.3, 0.7)

; --- The grab bar that IS fitted -------------------------------------------
;
; It is at the FAR end of the tub, which is the hazard: there is nothing to
; hold where you actually step in ("bathroom_no_grab_bar"). It is still a real
; GrabRail, so it glows and can be held.
;
; There is deliberately NO HandrailZone here. Scoring the participant for not
; holding a bar that this scenario says is in the wrong place contradicts the
; hazard they are being asked to spot, and the zone covered most of the
; bathroom floor, so simply walking in triggered "try using the rail here".
; Rail compliance is measured on the stairs, where the rail is where it should
; be. (To score bath transfers, move the bar to the step-in end first and then
; add a HandrailZone over that step-in area only.)

[node name="TubGrabBar" type="Area3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.05, 0.85, -1.38)
script = ExtResource("4_rail")
rail_id = "bathroom_tub_bar"
span = 0.3
radius = 0.018
rail_color = Color(0.85, 0.86, 0.88, 1)

