; ============================================================================
;  BEDROOM  --  4.0 x 3.6 m, 2.4 m ceiling. Doorway on the +Z wall.
;
;  Hazards: a lamp too dim and too far from the bed to be usable at night, a
;  chair with no armrests, and clutter directly on the bed-to-door path.
;
;  That path matters more than it looks. The single highest-risk journey in a
;  domestic setting is bed to bathroom at night, half-awake, in poor light --
;  so the clutter is placed exactly on it rather than tidily against a wall.
;
;  The balance exercise is run here because this room has the largest clear
;  floor area; see main.tscn for the exercise node itself.
; ============================================================================

[node name="Bedroom" type="Node3D"]

[node name="RoomBuilder" type="Node3D" parent="."]
script = ExtResource("1_room")
window_sill_height = 1.1
window_openings = Array[Vector4]([Vector4(1, -1.15, 1.3, 1)])
trim_surface = "paint_satin"
ceiling_surface = "ceiling_plaster"
wall_surface = "plaster_wall"
floor_surface = "carpet"
size = Vector2(4, 4.6)
height = 2.4
floor_color = Color(0.5, 0.42, 0.35, 1)
wall_color = Color(0.82, 0.8, 0.83, 1)
; Wall 0 (+Z) is the hallway's wall, doorway and all: building it here as well
; would put two identical boxes in the same plane and make them flicker. This
; room is 0.5 m longer than the hallway, so WallFillerEast below closes the bit
; of the south wall the hallway does not cover.
build_walls = Array[bool]([false, true, true, true])
openings = Array[Vector4]([])

[node name="RoomZone" type="Area3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.2, 0)
