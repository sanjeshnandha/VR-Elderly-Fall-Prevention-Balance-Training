; --- Core System I: the walking route -------------------------------------
; Finding a hazard and getting past one are different skills. These rings are
; the second: cross the room, one ring at a time, without touching anything.
; Some legs are deliberately NOT walkable in a straight line -- the direct path
; goes through something -- so the task is to see that and go round. Every leg
; was checked to have a clear path before it was placed here.

[node name="Route" type="Node3D" parent="."]
script = ExtResource("90_route")
room = "kitchen"
start_line = "Now move around the kitchen, ring by ring, without touching anything underfoot."

[node name="Marker1" type="Area3D" parent="Route"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.2, 0.0, -1.5)
script = ExtResource("91_marker")
marker_id = "kitchen_1"
room = "kitchen"
label_text = "in the doorway"
extents = Vector3(0.7, 3, 0.7)

[node name="Marker2" type="Area3D" parent="Route"]
