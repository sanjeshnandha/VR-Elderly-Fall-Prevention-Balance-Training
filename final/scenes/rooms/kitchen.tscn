script = ExtResource("4_slip")
zone_id = "kitchen_door_knock"
room = "kitchen"
linked_hazard_path = NodePath("../HazardOpenDoor")
warning_line = "Careful. That cupboard door is standing open across your path."
extents = Vector3(1.0, 2, 0.7)
route_extents = Vector3(0.62, 0.9, 0.16)
