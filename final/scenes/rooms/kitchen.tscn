; --- Hazard 3: the spill by the sink ---------------------------------------

[node name="WetFloor" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.95, 0, 1)
script = ExtResource("30_puddle")
; Was a 10 mm rounded box, pale blue, 35% metallic, 75% opaque -- which is
; four wrong answers about water at once. See puddle.gd.
size = Vector2(1.2, 1.1)
shape_seed = 2
; No damp ring; see bathroom.tscn.
damp_margin = 0.0
; A touch more opaque than the bathroom's: on dark slate a thinner film is read
; almost entirely by its reflection, which is the one cue the Smooth graphics
; level does not have. Both values came down with the defaults -- see
; puddle.gd: the pair of them were what made the spill read as a lamp on the
; floor rather than as water.
water_tint = Color(0.38, 0.44, 0.48, 1)
opacity = 0.45

[node name="HazardWetFloor" type="Area3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.95, 0.5, 1.0)
script = ExtResource("3_hazard")
hazard_id = "kitchen_wet_floor"
hazard_name = "Spill on the kitchen floor"
room = "kitchen"
is_hazard = true
explanation = "Wipe a spill the moment it happens. Hard kitchen tile with water on it is as slippery as the bathroom."
extents = Vector3(1.3, 1.0, 1.2)
label_height = 0.7
; Named rather than inferred. This volume is deliberately a metre tall so it is
; easy to aim at from standing, which means the overlap rule would otherwise
; light up the sink, two cupboard doors and the fruit bowl above the spill
; instead of the spill itself. See puddle.gd `_rebuild()` for the child name.
highlight_meshes = Array[NodePath]([NodePath("../WetFloor/Water")])

[node name="SlipZoneWetFloor" type="Area3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.95, 1.0, 1.0)
script = ExtResource("4_slip")
; 95% of this rectangle is under water; see bathroom.tscn.
route_extents = Vector3(0.94, 0.3, 0.86)
zone_id = "kitchen_spill_slip"
room = "kitchen"
linked_hazard_path = NodePath("../HazardWetFloor")
warning_line = "Careful. The floor is wet just there."
; Warning volume: 0.35 m of approach before the spoken line. Nothing is
; scored against it -- see route_extents.
extents = Vector3(1.9, 2.0, 1.7)

