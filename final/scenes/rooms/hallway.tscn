[node name="HazardRugEdge" type="Area3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.55, 0.45, 0)
script = ExtResource("3_hazard")
hazard_id = "hall_rug_edge"
hazard_name = "Curled rug edge"
room = "hallway"
is_hazard = true
explanation = "A lifted edge catches the toe of a shoe or a walking frame. Tape it down or take the rug up."
; The aim volume covers the WHOLE rug, because that is the object a participant
; points at -- nobody aims at the 160 mm lip on its own. The name and the
; explanation still say which part of it is the danger, and the label sits over
; the lifted edge rather than over the middle of the rug.
extents = Vector3(2.6, 0.9, 1.5)
label_offset = Vector3(0.9, 0, 0)
label_height = 0.6

[node name="SlipZoneRug" type="Area3D" parent="."]
