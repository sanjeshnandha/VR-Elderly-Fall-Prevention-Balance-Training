; ============================================================================
;  HALLWAY  --  8.0 x 2.6 m spine of the house, 2.4 m ceiling.
;
;  Doorways: bathroom and bedroom off the -Z wall, staircase off the +Z wall.
;  The west end (-X) is the starting area; the instruction panel and the
;  physical buttons are mounted on that wall in main.tscn.
;
;  Hazards: a rug with a curled edge, and an extension cord run across the
;  walkway. Both are trip hazards rather than slip hazards, which is why the
;  cord has no SlipZone -- catching a toe on a cord is not something a
;  non-vestibular warning can honestly simulate, so it is a recognition task
;  only.
; ============================================================================

[node name="Hallway" type="Node3D"]

[node name="RoomBuilder" type="Node3D" parent="."]
script = ExtResource("1_room")
architrave_both_sides = true
trim_surface = "paint_satin"
ceiling_surface = "ceiling_plaster"
wall_surface = "plaster_wall"
floor_surface = "oak_floor"
size = Vector2(12, 2.6)
height = 2.4
floor_color = Color(0.55, 0.47, 0.39, 1)
wall_color = Color(0.85, 0.83, 0.78, 1)
;  The spine of the house. Offsets below are along the wall, measured from the
;  middle of this room, which main.tscn places at world x = -2. So:
;    wall 1 (-Z, north): living room -4.1 (world -6.1), bathroom -0.5 (-2.5),
;                        bedroom +4.5 (+2.5)
;    wall 0 (+Z, south): kitchen -4.1 (world -6.1), front door -0.5 (-2.5),
;                        stairs +2.0 (world 0)
openings = Array[Vector4]([Vector4(1, -4.1, 0.9, 2.03), Vector4(1, -0.5, 0.9, 2.03), Vector4(1, 4.5, 0.9, 2.03), Vector4(0, -4.1, 0.9, 2.03), Vector4(0, -0.5, 0.9, 2.03), Vector4(0, 2, 0.9, 2.03)])

