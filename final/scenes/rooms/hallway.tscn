zone_id = "hall_rug_slip"
room = "hallway"
linked_hazard_path = NodePath("../HazardRugEdge")
warning_line = "Watch your feet. The edge of that rug is lifted."
; Tight to the lifted edge: walking round it must be possible, or "near miss"
; would measure the corridor's width rather than the participant's care.
; Warning volume. It must always CONTAIN the scored footprint below plus
; contact_margin, or part of what is scored sits outside the volume that
; starts watching for it. check_project.py enforces that.
extents = Vector3(1.1, 2.0, 2.2)

