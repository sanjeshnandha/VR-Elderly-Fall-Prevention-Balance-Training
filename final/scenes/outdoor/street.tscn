; --- Hazard 6: the open gully in the front path ----------------------------

; Sits ON the paving surface, so everything the node builds is measured from
; the ground and nothing can float. The grating it lifted out leans against the
; garden wall on the grass, which is where a crew actually puts it -- and a
; grating on edge with daylight through its bars is the one thing that cannot
; be mistaken for a paving slab.
[node name="FrontGully" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -2.5, -0.14, 5.905)
script = ExtResource("12_gully")
opening = Vector2(0.37, 0.26)
frame_margin = 0.045
depth = 0.42
; Bottom edge on the grass (10 mm below the paving), tipped back until the top
; edge meets the face of the garden wall at z 6.97.
grate_base = Vector3(-1, -0.01, 0.95)
grate_lean_degrees = 68.0
grate_yaw_degrees = 9.0

[node name="HazardOpenDrain" type="Area3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -2.5, 0.3, 5.905)
script = ExtResource("2_hazard")
hazard_id = "street_open_drain"
hazard_name = "Open drain in the path"
room = "street"
is_hazard = true
explanation = "A gully with its cover off is an ankle deep in the one place you look at least -- the path you have walked a thousand times. Cover it, and report it the same day."
extents = Vector3(0.9, 1.2, 0.9)
label_height = 0.6
; Named, not inferred: the hole is deeper than the aim volume and the grating
; is over by the wall, so neither is "mostly inside" it. What should light up
; is the opening, its rim, and the cover that belongs over it.
highlight_meshes = Array[NodePath]([NodePath("../FrontGully/Frame"), NodePath("../FrontGully/Shaft"), NodePath("../FrontGully/Grate")])

[node name="SlipZoneDrain" type="Area3D" parent="."]
