; --- Hazard 8: a branch at head height -------------------------------------
; The only hazard out here that is not underfoot, which is the point of it:
; everything else trains you to look down.

;  The branch used to be two boxes hanging in the sky at head height with
;  nothing above them -- a stick and a green blob, floating over the pavement.
;  A branch is the lowest limb of something, and without the something the
;  participant is not being asked to spot an overhanging branch, they are being
;  asked to work out what they are looking at.
;
;  The node stands at the BASE OF THE TRUNK on the lawn (top y -0.15), so every
;  part of the tree is measured up from the ground. `low_limb_to` is the far end
;  of the low limb, relative to that base: (0.85, 2.25, 1.75) puts it at world
;  (-5.00, 2.10, 8.00), out over the pavement, with its leaf clusters hanging to
;  about 1.55 m -- which is what you walk into.
[node name="StreetTree" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -5.85, -0.15, 6.25)
script = ExtResource("14_tree")
height = 4.8
trunk_radius = 0.18
lean_degrees = 4.0
limbs = 5
low_limb_to = Vector3(0.85, 2.25, 1.75)
leaf_cluster = 0.42
canopy_blobs = 9
canopy_radius = 1.5
shape_seed = 1

[node name="HazardLowBranch" type="Area3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -5.1, 1.9, 7.85)
script = ExtResource("2_hazard")
hazard_id = "street_low_branch"
hazard_name = "Branch hanging at head height"
room = "street"
is_hazard = true
explanation = "Catching your head makes you step back, and stepping back is how people go over. Duck under it or walk round, and ask for it to be cut."
extents = Vector3(1.9, 0.95, 1.3)
label_height = 0.55
; The limb and its leaves, not the whole tree: lighting up a four-metre tree
; would say "that tree", and what is being pointed out is the branch over the
; pavement.
highlight_meshes = Array[NodePath]([NodePath("../StreetTree/LowLimb"), NodePath("../StreetTree/LowLimbLeaves")])

