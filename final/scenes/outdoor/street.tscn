; --- Street practice 2: crossing on the green man ---------------------------
; Armed by the button on the pole; the rings appear when the green man does.

[node name="CrossingPractice" type="Node3D" parent="."]
script = ExtResource("11_practice")
room = "street"
practice_id = "street_crossing_run"
signal_path = NodePath("../CrossingSignal")
crossing_path = NodePath("../RoadCrossing")
start_grace = 3.5
start_limit = 9.0
off_allowance = 0.7
off_limit = 3.0
; What the rings say coming back, in the order they are reached.
return_labels = Array[String](["wait here", "onto the crossing", "halfway", "nearly there", "back on the pavement"])

; Five rings, and both END rings stand on a PAVEMENT.
;
; There were four, from z 10.1 (already in the road) to 17.3. That works once,
; outwards. Coming back, the last ring of the run was the one at 10.1 -- so the
; return crossing finished with the participant standing in the carriageway,
; being congratulated. Both ends are on a footway now, so the run ends where it
; should whichever way it is walked.
;
;   8.7   near pavement      the one you wait on
;   10.6  just into the road
;   12.8  the middle
;   15.0  nearly across
;   16.9  far pavement

