; --- Hazard 3: wet leaves --------------------------------------------------

; Moved east onto the line between the gate and the crossing: west of the
; gate it was never on anybody's way anywhere.
;
; A hundred and ten individual leaves, not a brown box. The pavement surface is
; at y -0.14, and this node sits ON it, so every leaf is measured from the
; ground. See leaf_litter.gd for why one flat colour could never have worked.
[node name="WetLeaves" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.9, -0.14, 7.95)
script = ExtResource("13_leaves")
size = Vector2(1.5, 0.75)
leaves = 110
shape_seed = 3
; Soaked: dark, and shiny enough to catch the sky, which is the cue that says
; "slippery" before anybody reads the label.
wetness = 0.78

[node name="HazardWetLeaves" type="Area3D" parent="."]
; Reaches the ground: at y 0.4 with a 1.0 height it stopped 35 mm above the
; leaves themselves, so there was nothing inside it to light up.
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.9, 0.3, 7.95)
script = ExtResource("2_hazard")
hazard_id = "street_wet_leaves"
hazard_name = "Wet leaves on the pavement"
room = "street"
is_hazard = true
explanation = "Wet leaves are as slippery as ice. Walk round them, or brush them away before they pack down."
extents = Vector3(1.6, 1.0, 0.9)
label_height = 0.7
; Named: the drift is built at run time and is 35 mm deep inside a volume a
; metre tall, so the overlap rule would never call it "mostly inside".
highlight_meshes = Array[NodePath]([NodePath("../WetLeaves/Leaves"), NodePath("../WetLeaves/Mulch")])

[node name="SlipZoneLeaves" type="Area3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.9, 0.8, 7.95)
script = ExtResource("3_slip")
zone_id = "street_leaves_slip"
room = "street"
linked_hazard_path = NodePath("../HazardWetLeaves")
warning_line = "Careful. Wet leaves are as slippery as ice."
; The drift of wet leaves: all of it is slippery.
route_extents = Vector3(1.5, 0.3, 0.75)
; Warning volume: 0.45 m of approach before the spoken line. Nothing is
; scored against it -- see route_extents.
extents = Vector3(2.4, 2.0, 1.6)

