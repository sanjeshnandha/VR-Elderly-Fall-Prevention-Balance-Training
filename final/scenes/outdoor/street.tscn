script = ExtResource("15_person")
; Pavement, kerb, road, far kerb, far pavement -- and the same in reverse, so
; the return leg waits for a green man too. The road points are at the road
; surface (-0.27) and the pavement points at -0.14, so they step down and up.
path_points = Array[Vector3]([Vector3(1.2, -0.14, 7.9), Vector3(1.2, -0.14, 9.15), Vector3(1.2, -0.27, 9.35), Vector3(1.2, -0.27, 15.05), Vector3(1.2, -0.14, 16.8), Vector3(1.2, -0.14, 15.25), Vector3(1.2, -0.27, 15.05), Vector3(1.2, -0.27, 9.35)])
