; --- Core System J: the signalled crossing ---------------------------------
; One controller, four posts. Splitting them is what lets a primary and a
; secondary head show the same thing without two timers that can drift apart.

[node name="CrossingSignal" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.6, 12.8)
script = ExtResource("7_signal")
minimum_green = 6.0
amber_seconds = 3.0
all_red_seconds = 2.0
; The road is 7 m. At the 0.7 m/s an unhurried older walker actually manages,
; that is 10 s to cross and 6 s more to finish if they set off late.
walk_seconds = 10.0
clearing_seconds = 6.0
rest_in_green = true
bleeper = true

; The pedestrian posts. The near one is on the west side of the crossing,
; because the front path arrives at x = -2.5 and that is the side they reach
; first. The far one shows both ways: its big face is what you read from this
; side of the road.

[node name="PedPostNear" type="Node3D" parent="."]
; East edge of the crossing. It was at x = -2.9, which is inside the front
; path -- a pole to walk into on the way out of your own gate.
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 2.6, -0.14, 8.95)
script = ExtResource("8_post")
kind = 1
controller_path = NodePath("../CrossingSignal")
facing_degrees = 0.0
has_button = true
back_to_back = false

[node name="PedPostFar" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 2.9, -0.14, 16.65)
script = ExtResource("8_post")
kind = 1
controller_path = NodePath("../CrossingSignal")
facing_degrees = 180.0
has_button = true
back_to_back = true

; Traffic heads, each facing its own oncoming lane. Yaw 90 looks along -X.

[node name="TrafficPostNear" type="Node3D" parent="."]
; 0.8 m clear of the front path, which ends at x = -3.0.
