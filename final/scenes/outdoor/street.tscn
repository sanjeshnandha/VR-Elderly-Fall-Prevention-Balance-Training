; --- People -----------------------------------------------------------------
; An empty street is a strange place, and it teaches the wrong thing: somebody
; who only ever sees an empty crossing never sees what people normally do at
; one. None of them is solid -- a moving obstacle that can corner somebody
; against a wall is worse than an empty street -- and each of them stops and
; waits if the participant is in the way. See pedestrian.gd.

; Along the far pavement, back and forth, well clear of everything scored.
[node name="PersonFarPavement" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -14, -0.14, 16.9)
script = ExtResource("15_person")
path_points = Array[Vector3]([Vector3(-14, -0.14, 16.9), Vector3(14, -0.14, 16.9)])
speed = 1.15
pause_seconds = 2.5
height = 1.72
coat_color = Color(0.3, 0.36, 0.3, 1)
trouser_color = Color(0.22, 0.22, 0.26, 1)

